{
  "name": "rm-design",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:launch": "node tests/check-launch.mjs",
    "test:public": "node tests/check-public-seo.mjs && node tests/check-content-seo.mjs && node tests/check-page-data.mjs && node tests/check-public-api-errors.mjs && node tests/check-media-delivery.mjs",
    "test:browser": "node tests/serve-launch-browser.mjs",
    "test:lighthouse": "node tests/run-lighthouse.mjs",
    "test:production-package": "node tests/check-production-package.mjs --front=https://rm.chungci-design.com --api=https://rm-api.chungci-design.com",
    "dev": "vite",
    "build": "vite build && node scripts/prepare-php-entry.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@unhead/vue": "^3.1.8",
    "body-scroll-lock": "^4.0.0-beta.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.34",
    "vue-awesome-paginate": "^1.2.0",
    "vue-router": "^5.1.0",
    "vue3-masonry-css": "^1.0.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "lighthouse": "12.8.2",
    "vite": "^8.0.12"
  }
}
