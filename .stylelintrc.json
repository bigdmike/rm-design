{
  "plugins": ["stylelint-no-unsupported-browser-features"],
  "rules": {
    "plugin/no-unsupported-browser-features": [
      true,
      {
        "severity": "warning",
        "ignore": [
          "css-nesting",           
          "viewport-unit-variants",
          "css-marker-pseudo",     
          "css-grid-animation"     
        ]
      }
    ]
  }
}